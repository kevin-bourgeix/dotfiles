# sourced by ~/.zshenv (stub: echo 'source ~/.config/zsh/zshenv' > ~/.zshenv)
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CACHE_HOME="$HOME/.cache"
export EDITOR=nvim
export VISUAL=nvim
export PAGER=less
export LANG=en_US.UTF-8
export STARSHIP_CONFIG="$XDG_CONFIG_HOME/starship.toml"
typeset -U path  # dedupe
path=(/opt/homebrew/bin /opt/homebrew/sbin /opt/homebrew/opt/rustup/bin $HOME/.cargo/bin $HOME/.local/bin $path)
