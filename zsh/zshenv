# sourced by ~/.zshenv (stub: echo 'source ~/.config/zsh/zshenv' > ~/.zshenv)
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CACHE_HOME="$HOME/.cache"
export EDITOR=nvim
export VISUAL=nvim
export PAGER=less
export LANG=en_US.UTF-8
export STARSHIP_CONFIG="$XDG_CONFIG_HOME/starship.toml"
typeset -U path  # dedupe
export NVM_DIR="$HOME/.nvm"
export PNPM_HOME="$HOME/Library/pnpm"
path=(/opt/homebrew/bin /opt/homebrew/sbin /opt/homebrew/opt/rustup/bin $HOME/.cargo/bin $HOME/.local/bin $PNPM_HOME $path)
# default nvm node on PATH without sourcing nvm.sh (nvm itself is lazy-loaded in zshrc)
_nvm_node=($NVM_DIR/versions/node/v$(<$NVM_DIR/alias/default 2>/dev/null)*(NOn[1]))
[[ -d $_nvm_node ]] && path=($_nvm_node/bin $path)
unset _nvm_node
